# Copy to .env and fill in. .env is git-ignored; this file is not, so never
# put a real value here.
#
#   cp .env.example .env
#
# Everything is optional - without any of it the assistant runs against the
# bundled sample calendar using an offline keyword model.

# Real answers instead of raw tool output. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional model override.
# ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Your own calendar
# ---------------------------------------------------------------------------

# A plain .ics file on disk.
# CALENDAR_FILE=/Users/you/exported.ics

# Use the real clock. Without this, "now" is pinned to 3 August 2026 so the
# bundled sample calendar has something to show.
# CALENDAR_NOW=now

# Google Calendar -> Settings -> your calendar -> Integrate calendar
# -> "Secret address in iCal format".
#
# TREAT THIS AS A PASSWORD. Anyone holding it can read your entire calendar,
# forever, with no login. It cannot be scoped and it does not expire until you
# reset it.
GOOGLE_ICS_URL=

# ---------------------------------------------------------------------------
# Working hours, used when looking for free time
# ---------------------------------------------------------------------------
# WORK_START_HOUR=9
# WORK_END_HOUR=17

# ---------------------------------------------------------------------------
# The one timezone this assistant assumes you are in
# ---------------------------------------------------------------------------
# A zone name, never an offset: "EST" is -05:00 all year and therefore wrong
# from March to November. Everything internal stays naive; this is what the
# edges convert against.
# CALENDAR_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Cost
# ---------------------------------------------------------------------------
# How hard the model thinks before answering, and the main cost lever: thinking
# is billed as output tokens. "low" suits this project, where Python does every
# date calculation. Raise it if answers start missing the point.
# ANTHROPIC_EFFORT=low

# ---------------------------------------------------------------------------
# Signing in to Google (needed for --source api and for writing)
# ---------------------------------------------------------------------------
# Downloaded from the Google Cloud console as an OAuth client of type
# "Desktop app". See "Signing in" in the README. Both files are git-ignored.
# CREDENTIALS_FILE=credentials.json
# TOKEN_FILE=token.json

# Hand the token back to Google and delete it when a signed-in session ends, so
# nothing usable is left on disk. The cost is a browser consent on every run.
# Set to 0 to stay signed in between runs.
# REVOKE_ON_EXIT=1

# How long to wait for the browser during sign-in. Choosing "Back to safety" on
# the unverified-app warning leaves without answering, and this is what stops
# the wait from lasting forever.
# AUTH_TIMEOUT_SECONDS=120
