# Copy to .env and fill in. .env is git-ignored; this file is not, so never
# put a real value here.
#
#   cp .env.example .env
#
# Everything is optional - without any of it the assistant runs against the
# bundled sample calendar using an offline keyword model.

# Real answers instead of raw tool output. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional model override.
# ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Your own calendar
# ---------------------------------------------------------------------------

# A plain .ics file on disk.
# CALENDAR_FILE=/Users/you/exported.ics

# Use the real clock. Without this, "now" is pinned to 3 August 2026 so the
# bundled sample calendar has something to show.
# CALENDAR_NOW=now

# Google Calendar -> Settings -> your calendar -> Integrate calendar
# -> "Secret address in iCal format".
#
# TREAT THIS AS A PASSWORD. Anyone holding it can read your entire calendar,
# forever, with no login. It cannot be scoped and it does not expire until you
# reset it.
GOOGLE_ICS_URL=

# ---------------------------------------------------------------------------
# Working hours, used when looking for free time
# ---------------------------------------------------------------------------
# WORK_START_HOUR=9
# WORK_END_HOUR=17
