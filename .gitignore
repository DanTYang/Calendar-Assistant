__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env
.DS_Store

# Local data - never commit a real calendar or exported notes
data/facts.json
# One file per user once more than one person is served. Whatever anyone told
# the assistant to remember about themselves lives here.
data/facts/
data/*.ics
!data/sample_calendar.ics
credentials.json
token.json

# OAuth client downloads. Every one of these carries a client secret, and the
# name varies with how it was saved - Google's own default is
# client_secret_<id>.apps.googleusercontent.com.json - so match the shapes
# rather than one filename.
OAuthCrediential.json
OAuthCredential*.json
OAuthCredentials*.json
client_secret*.json
*client_secret*.json

# Test suite - kept local, not published
tests/
pytest.ini

# The gateway's database. Now that it is a file rather than memory it holds
# real refresh tokens - long-lived calendar access for every account that has
# signed in. Never commit it.
gateway/data/
*.mv.db
*.trace.db

# Per-person spending ledgers. Not secret in the way a token is, but it is a
# record of who used this and how much - other people's, not only yours.
data/spend/
